# Auth0 Configuration
# Get these from your Auth0 dashboard at https://manage.auth0.com

# Server-side (private)
NUXT_AUTH0_DOMAIN=your-tenant.auth0.com
NUXT_AUTH0_CLIENT_ID=your-client-id
NUXT_AUTH0_CLIENT_SECRET=your-client-secret
NUXT_AUTH0_AUDIENCE=https://your-api-identifier

# Client-side (public)
NUXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NUXT_PUBLIC_AUTH0_CLIENT_ID=your-client-id
NUXT_PUBLIC_AUTH0_AUDIENCE=https://your-api-identifier

# DATABASE_URL=postgresql://neondb_owner:
# local test
DATABASE_URL=postgresql://todo_user:todo_password@localhost:5432/todo_app